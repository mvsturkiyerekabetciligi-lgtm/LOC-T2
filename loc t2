function Get-PrefetchLastRunTime {
    param([string]$FilePath)
    try {
        $fs = [System.IO.File]::OpenRead($FilePath)
        try {
            $buffer = New-Object byte[] 144
            $read = $fs.Read($buffer, 0, $buffer.Length)
            if ($read -lt 24) { return "Unknown" }
            $version = [BitConverter]::ToInt32($buffer, 0)
            $candidates = @()
            if ($read -ge 24) { $candidates += [BitConverter]::ToInt64($buffer, 16) }
            if ($read -ge 136 -and $version -ge 26) { $candidates += [BitConverter]::ToInt64($buffer, 128) }
            foreach ($fileTime in $candidates) {
                if ($fileTime -le 0) { continue }
                try {
                    $dt = [DateTime]::FromFileTimeUtc($fileTime).ToLocalTime()
                    if ($dt.Year -ge 2000 -and $dt.Year -le 2100) { return $dt.ToString("yyyy-MM-dd HH:mm:ss") }
                } catch {}
            }
            return "Unknown"
        } finally { $fs.Close() }
    } catch { return "Unknown" }
}

