function Get-ProcessSuspiciousReasons {
    param([string]$ProcessName, [string]$ExecutablePath)
    $reasons = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    if ([string]::IsNullOrWhiteSpace($ExecutablePath)) {
        if ($ProcessName -notmatch '(?i)^(System|Registry|Secure System|Memory Compression|Idle)$') { [void]$reasons.Add('no image path') }
    }
