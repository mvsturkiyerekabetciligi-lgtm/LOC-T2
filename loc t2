}

function Test-UserLandProcessPath {
    param([string]$ExecutablePath)
    if ([string]::IsNullOrWhiteSpace($ExecutablePath)) { return $false }
    $path = $ExecutablePath.ToLower().Replace('/', '\')
    # kopya2 klasoru SESSIZ gec
    if ($path -like '*\kopya2\*') { return $false }
    foreach ($marker in @('\downloads\', '\desktop\', '\appdata\', '\temp\', '\programdata\')) {
        if ($path -like "*$marker*") { return $true }
    }
    return $false
}

function Get-ProcessSnapshot {
    $snap = @{}
    try {
        Get-CimInstance Win32_Process -ErrorAction Stop | ForEach-Object {
            $procId = [int]$_.ProcessId
            $path = [string]$_.ExecutablePath
            $name = [string]$_.Name
            $reasons = @(Get-ProcessSuspiciousReasons -ProcessName $name -ExecutablePath $path)
            $isKopya2 = $false
            if ($path -and ($path -like '*\kopya2\*')) { $isKopya2 = $true }
            $snap[$procId] = @{
                Name       = $name
                Path       = $path
                Reasons    = $reasons
                UserLand   = if ($isKopya2) { $false } else { Test-UserLandProcessPath -ExecutablePath $path }
                Suspicious = ($reasons.Count -gt 0)
                Silent     = $isKopya2
            }
        }
    } catch {}
    return $snap
}

function Update-ProcessChangeMonitor {
    param([hashtable]$Previous, [hashtable]$Current, [hashtable]$Watched, [string]$LogFile)

    # Yeni açılan process'ler
    foreach ($procId in $Current.Keys) {
        if ($Previous.ContainsKey($procId)) { continue }

        $proc = $Current[$procId]
        if ($proc.Silent) { continue }

        if ($proc.Suspicious) { $Watched[$procId] = $proc }
        elseif ($proc.UserLand) { $Watched[$procId] = $proc }

        if (-not $proc.Suspicious -and -not $proc.UserLand) { continue }

        $label = "$($proc.Name) (PID $procId)"
        if ($proc.Path) { $label += " -> $($proc.Path)" }

        $tags = @($proc.Reasons | Where-Object { $_ -ne 'no image path' })
        if ($tags.Count -gt 0) {
            Write-MonitorAlert -Message "Started [$($tags -join ', ')]: $label" -LogFile $LogFile -Color Yellow
        } else {
            Write-MonitorAlert -Message "Started: $label" -LogFile $LogFile -Color Yellow
        }
    }

    # Kapanan process'ler
    foreach ($procId in $Previous.Keys) {
        if ($Current.ContainsKey($procId)) { continue }
        if (-not $Watched.ContainsKey($procId)) { continue }

        $proc = $Previous[$procId]
        if ($proc.Silent) { continue }

        $label = "$($proc.Name) (PID $procId)"
        if ($proc.Path) { $label += " -> $($proc.Path)" }

        $tags = @($proc.Reasons | Where-Object { $_ -ne 'no image path' })
        if ($tags.Count -gt 0) {
            Write-MonitorAlert -Message "Exited [$($tags -join ', ')]: $label" -LogFile $LogFile -Color Yellow
        } else {
            Write-MonitorAlert -Message "Exited: $label" -LogFile $LogFile -Color Yellow
        }
        $Watched.Remove($procId) | Out-Null
    }
}

