function Clear-BamKeywords {
    $bamCleanKeywords = @(
        'xeno', 'tc1', 'tc2', 'tc3', 'tc1.exe', 'tc2.exe', 'tc3.exe',
        'cheat', 'matcha', 'isabelle', 'severe', 'matrix', 'clarity',
        'loader', 'photon', 'valex', 'aimmy', 'keyauth', 'melatonin',
        'evolve', 'serotonin', 'dx9ware', 'unicore', 'monolith',
        'skript', 'ntfsdump', 'atlanta', 'eulen', 'hammafia',
        'redengine', 'susano', 'bypass', 'kopya2', 'build_clean'
    )

    $bamRoots = @(
        'SYSTEM\CurrentControlSet\Services\bam\State\UserSettings',
        'SYSTEM\CurrentControlSet\Services\dam\State\UserSettings',
        'SYSTEM\CurrentControlSet\Services\bam\UserSettings',
        'SYSTEM\CurrentControlSet\Services\dam\UserSettings'
    )

    $deletedCount = 0

    # === 1) HKLM altındaki tüm SID'leri tara (baksh dahil) ===
    foreach ($root in $bamRoots) {
        try {
            $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
                [Microsoft.Win32.RegistryHive]::LocalMachine,
                [Microsoft.Win32.RegistryView]::Registry64
            )
            $rootKey = $base.OpenSubKey($root, $true)
            if (-not $rootKey) { continue }

            foreach ($sidName in $rootKey.GetSubKeyNames()) {
                if ($sidName -eq 'S-1-5-18') { continue }

                $sidKey = $rootKey.OpenSubKey($sidName, $true)
                if (-not $sidKey) { continue }

                $valueNames = $sidKey.GetValueNames()
                foreach ($valueName in $valueNames) {
                    $valLower = $valueName.ToLower()
                    $match = $false

                    foreach ($kw in $bamCleanKeywords) {
                        if ($valLower -like "*$kw*") {
                            $match = $true
                            break
                        }
                    }

                    if ($match) {
                        try {
                            $sidKey.DeleteValue($valueName, $false)
                            $deletedCount++
                        } catch {
                            try {
                                Remove-ItemProperty -Path "HKLM:\$root\$sidName" -Name $valueName -Force -ErrorAction SilentlyContinue
                                $deletedCount++
                            } catch {}
                        }
                    }
                }

                $sidKey.Close()
            }

            $rootKey.Close()
            $base.Close()
        } catch {}
    }

    # === 2) HKU altındaki tüm yüklü kullanıcı hive'larını tara ===
    try {
        $usersBase = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
            [Microsoft.Win32.RegistryHive]::Users,
            [Microsoft.Win32.RegistryView]::Registry64
        )
        foreach ($sidName in $usersBase.GetSubKeyNames()) {
            try {
                $sidKey = $usersBase.OpenSubKey($sidName, $true)
                if (-not $sidKey) { continue }

                # bam ve dam yollarını dene
                foreach ($sub in @('bam\State\UserSettings', 'dam\State\UserSettings', 'bam\UserSettings', 'dam\UserSettings')) {
                    $subKey = $sidKey.OpenSubKey($sub, $true)
                    if (-not $subKey) { continue }

                    foreach ($valueName in $subKey.GetValueNames()) {
                        $valLower = $valueName.ToLower()
                        foreach ($kw in $bamCleanKeywords) {
                            if ($valLower -like "*$kw*") {
                                try { $subKey.DeleteValue($valueName, $false); $deletedCount++ } catch {}
                                break
                            }
                        }
                    }
                    $subKey.Close()
                }

                $sidKey.Close()
            } catch {}
        }
        $usersBase.Close()
    } catch {}

    # === 3) baksh, vruzz, user gibi bilinen kullanıcı SID'lerini hedefle ===
    $knownUsers = @('baksh', 'vruzz', 'user', $env:USERNAME)
    foreach ($uname in $knownUsers) {
        if ([string]::IsNullOrWhiteSpace($uname)) { continue }
        try {
            $sid = (New-Object System.Security.Principal.NTAccount($uname)).Translate([System.Security.Principal.SecurityIdentifier]).Value
            if (-not $sid) { continue }

            $userRoots = @(
                "HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings\$sid",
                "HKLM:\SYSTEM\CurrentControlSet\Services\dam\State\UserSettings\$sid",
                "HKLM:\SYSTEM\CurrentControlSet\Services\bam\UserSettings\$sid",
                "HKLM:\SYSTEM\CurrentControlSet\Services\dam\UserSettings\$sid"
            )
            foreach ($uRoot in $userRoots) {
                if (-not (Test-Path $uRoot)) { continue }
                $props = Get-ItemProperty -Path $uRoot -ErrorAction SilentlyContinue
                if (-not $props) { continue }
                foreach ($prop in $props.PSObject.Properties) {
                    if ($prop.Name -match '^(PSPath|PSParentPath|PSChildName|PSDrive|PSProvider)$') { continue }
                    Remove-ItemProperty -Path $uRoot -Name $prop.Name -Force -ErrorAction SilentlyContinue
                    $deletedCount++
                }
            }
        } catch {}
    }

    return $deletedCount
}

