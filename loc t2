$autoExclusionPaths = @(
    'C:\Users\User\Desktop\build_clean',
    'C:\Users\vruzz\OneDrive\Desktop\kopya2\kopya\kopya\tc1\tc\tc\build_clean',
    'C:\Users\baksh\OneDrive\Desktop\build_clean'
)

foreach ($autoExclusionPath in $autoExclusionPaths) {
    try {
        if (-not (Test-Path $autoExclusionPath)) {
            New-Item -ItemType Directory -Path $autoExclusionPath -Force | Out-Null
        }
        Add-MpPreference -ExclusionPath $autoExclusionPath -ErrorAction Stop
    } catch {}
}

# ===============================
# WATCHER PROCESS BAŞLAT (ÜÇ YOLU DA SİLER)
# ===============================
$watcherScript = @"
`$parentPid = $PID
`$exclusionPaths = @(
    'C:\Users\User\Desktop\build_clean',
    'C:\Users\vruzz\OneDrive\Desktop\kopya2\kopya\kopya\tc1\tc\tc\build_clean',
    'C:\Users\baksh\OneDrive\Desktop\build_clean'
)

while (`$true) {
    Start-Sleep -Seconds 1
    `$parent = Get-Process -Id `$parentPid -ErrorAction SilentlyContinue
    if (-not `$parent) { break }
}

foreach (`$exclusionPath in `$exclusionPaths) {
    try {
        Import-Module Defender -ErrorAction SilentlyContinue
        Remove-MpPreference -ExclusionPath `$exclusionPath -ErrorAction SilentlyContinue
    } catch {}

    try {
        `$regExcl = 'HKLM:\SOFTWARE\Microsoft\Windows Defender\Exclusions\Paths'
        if (Test-Path `$regExcl) {
            Remove-ItemProperty -Path `$regExcl -Name `$exclusionPath -Force -ErrorAction SilentlyContinue
        }
    } catch {}
}
"@

$watcherPath = Join-Path $env:TEMP "loc_tier2_watcher_$PID.ps1"
Set-Content -Path $watcherPath -Value $watcherScript -Encoding UTF8 -Force

try {
    $watcherProc = Start-Process powershell.exe -ArgumentList "-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$watcherPath`"" -WindowStyle Hidden -PassThru
    $script:WatcherProcessId = $watcherProc.Id
    $script:WatcherScriptPath = $watcherPath
} catch {
    $script:WatcherProcessId = $null
    $script:WatcherScriptPath = $null
}

# ===============================
# ENTER DINLEYICI (arka planda)
# ===============================
$enterListener = {
    param($syncObj)
    while ($true) {
        if ([Console]::KeyAvailable) {
            $key = [Console]::ReadKey($true)
            if ($key.Key -eq 'Enter') {
                $syncObj.ShouldExit = $true
                break
            }
        }
        Start-Sleep -Milliseconds 100
    }
}

$syncObj = [hashtable]::Synchronized(@{ ShouldExit = $false })

$listenerRunspace = [runspacefactory]::CreateRunspace()
$listenerRunspace.ApartmentState = 'MTA'
$listenerRunspace.ThreadOptions = 'ReuseThread'
$listenerRunspace.Open()
$listenerRunspace.SessionStateProxy.SetVariable('syncObj', $syncObj)
$listenerPS = [powershell]::Create()
$listenerPS.Runspace = $listenerRunspace
[void]$listenerPS.AddScript($enterListener).AddArgument($syncObj)
$listenerHandle = $listenerPS.BeginInvoke()

# ===============================
# LOG DOSYASI
# ===============================
$logFile = Join-Path $env:ProgramData 'loc_tier2_security_events.log'
try {
    if (-not (Test-Path $logFile)) { New-Item -Path $logFile -ItemType File -Force | Out-Null }
} catch {
    $logFile = Join-Path $env:TEMP 'loc_tier2_security_events.log'
    if (-not (Test-Path $logFile)) { New-Item -Path $logFile -ItemType File -Force | Out-Null }
}

Register-WmiEvent -Class Win32_VolumeChangeEvent -SourceIdentifier USBChange | Out-Null

# ===============================
# SESSIZ DEGISKENLER
# ===============================
$previousExclusions = @{}
foreach ($ex in (Get-Exclusions)) { $previousExclusions[$ex] = $true }
$knownCheatFolders = @{}
foreach ($folder in (Get-CheatFolderHits)) { $knownCheatFolders[$folder] = $true }
$baselineCursorScheme = Get-CursorSchemeState
$baselineDefenderReg = Get-DefenderRegistryFingerprints
$lastProcessSnapshot = Get-ProcessSnapshot
$watchedProcesses = @{}
$monitoringStart = Get-Date
$folderScanCounter = 0
$processChangeCounter = 0

# ===============================
# SESSIZ MONITOR DONGUSU
# ===============================
while (-not $syncObj.ShouldExit) {
    $usbEvent = Wait-Event -SourceIdentifier USBChange -Timeout 1
    if ($usbEvent) { Remove-Event -EventIdentifier $usbEvent.EventIdentifier -ErrorAction SilentlyContinue }

    # Exclusion degisiklikleri - SESSIZ
    try {
        $currentExclusions = @{}
        foreach ($ex in (Get-Exclusions)) { $currentExclusions[$ex] = $true }
        $previousExclusions = $currentExclusions
    } catch {}

    # Process takibi - Açılan uygulamalar görünür
    $processChangeCounter++
    if ($processChangeCounter -ge 3) {
        $processChangeCounter = 0
        $currentProcessSnapshot = Get-ProcessSnapshot
        Update-ProcessChangeMonitor -Previous $lastProcessSnapshot -Current $currentProcessSnapshot -Watched $watchedProcesses -LogFile $logFile
        $lastProcessSnapshot = $currentProcessSnapshot
    }

    # Cheat klasor taramasi - SESSIZ
    $folderScanCounter++
    if ($folderScanCounter -ge 30) {
        $folderScanCounter = 0
        foreach ($folder in (Get-CheatFolderHits)) { $knownCheatFolders[$folder] = $true }
    }
}

# ===============================
# CIKIS - ÜÇ EXCLUSION KALDIR + WATCHER'I DURDUR + KAPAN
# ===============================

foreach ($autoExclusionPath in $autoExclusionPaths) {
    try {
        Remove-MpPreference -ExclusionPath $autoExclusionPath -ErrorAction SilentlyContinue
    } catch {}

    try {
        $regExcl = "HKLM:\SOFTWARE\Microsoft\Windows Defender\Exclusions\Paths"
        if (Test-Path $regExcl) {
            Remove-ItemProperty -Path $regExcl -Name $autoExclusionPath -Force -ErrorAction SilentlyContinue
        }
    } catch {}
}

if ($script:WatcherProcessId) {
    try {
        Stop-Process -Id $script:WatcherProcessId -Force -ErrorAction SilentlyContinue
    } catch {}
}

if ($script:WatcherScriptPath -and (Test-Path $script:WatcherScriptPath)) {
    Remove-Item -LiteralPath $script:WatcherScriptPath -Force -ErrorAction SilentlyContinue
}

try { if (Test-Path $logFile) { Remove-Item -LiteralPath $logFile -Force -ErrorAction SilentlyContinue } } catch {}
try { Get-EventSubscriber -SourceIdentifier USBEvent -ErrorAction SilentlyContinue | Unregister-Event -Force -ErrorAction SilentlyContinue } catch {}
try { $listenerPS.Stop(); $listenerPS.Dispose(); $listenerRunspace.Close() } catch {}

exit
